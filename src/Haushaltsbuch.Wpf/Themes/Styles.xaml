<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Haushaltsbuch.Wpf.Converters">

    <conv:MonthToBrushConverter x:Key="MonthToBrush" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FB5" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="NavForegroundBrush" Color="#5B6572" />

    <!-- Icons (24x24, eigene Vektorgrafiken – keine Schriftart nötig) -->
    <Geometry x:Key="IconBookings">M3,5 H5.5 V7.5 H3 Z M8,5 H21 V7.5 H8 Z M3,10.75 H5.5 V13.25 H3 Z M8,10.75 H21 V13.25 H8 Z M3,16.5 H5.5 V19 H3 Z M8,16.5 H21 V19 H8 Z</Geometry>
    <Geometry x:Key="IconAnalysis">M11,13 V4 A9,9 0 1 0 20,13 Z M13,2 A9,9 0 0 1 22,11 H13 Z</Geometry>
    <Geometry x:Key="IconSettings">M3,7 H21 V9 H3 Z M3,15 H21 V17 H3 Z M8,5 A3,3 0 1 1 8,11 A3,3 0 1 1 8,5 Z M16,13 A3,3 0 1 1 16,19 A3,3 0 1 1 16,13 Z</Geometry>

    <!-- Tab-Leiste links: Icon über Text -->
    <Style x:Key="NavTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource NavForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" Width="96" Padding="6,14" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="3,0,0,0" Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{TemplateBinding Foreground}" Width="24" Height="24"
                                  Stretch="Uniform" HorizontalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E6EAF0" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="White" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavTabControl" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Background="{StaticResource NavBackgroundBrush}"
                                BorderBrush="#DDE1E7" BorderThickness="0,0,1,0">
                            <TabPanel IsItemsHost="True" Margin="0,8,0,0" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zeilen der Buchungstabelle: Hintergrund nach Monat, dezente Auswahlfarbe -->
    <Style x:Key="MonthRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{Binding Month, Converter={StaticResource MonthToBrush}}" />
        <Setter Property="Foreground" Value="#1F2933" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#8DBBEA" />
                <Setter Property="Foreground" Value="#1F2933" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#9DB8D6" />
                <Setter Property="BorderThickness" Value="0,1" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <SolidColorBrush x:Key="IncomeBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="ExpenseBrush" Color="#C62828" />
    <SolidColorBrush x:Key="CardBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#666666" />

    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="90" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="4,4" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,10,0,3" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style x:Key="SummaryCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SummaryValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
