<UserControl x:Class="Haushaltsbuch.Wpf.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Haushaltsbuch.Wpf.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Jahr gilt für beide Seiten -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,20,12">
            <TextBlock Text="Auswertung für das Jahr" VerticalAlignment="Center" Margin="0,0,10,0"
                       FontSize="14" Foreground="{StaticResource MutedBrush}" />
            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" MinWidth="90" />
        </StackPanel>

        <!-- Links/Rechts-Aufteilung -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:CategoryBreakdownView Grid.Column="0" DataContext="{Binding Income}" />
            <Border Grid.Column="1" Background="#DDE1E7" Margin="0,0,0,16" />
            <views:CategoryBreakdownView Grid.Column="2" DataContext="{Binding Expenses}" />
        </Grid>
    </Grid>
</UserControl>
