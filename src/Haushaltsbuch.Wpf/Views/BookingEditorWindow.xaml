<Window x:Class="Haushaltsbuch.Wpf.Views.BookingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Art" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Ausgabe" IsChecked="{Binding IsExpense}" Margin="0,0,20,0" />
            <RadioButton Content="Einnahme" IsChecked="{Binding IsIncome}" />
        </StackPanel>

        <TextBlock Text="Datum" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding Date}" />

        <TextBlock Text="Beschreibung" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DescriptionBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="200" />

        <TextBlock Text="Betrag (€)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Kategorie" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="Name" />

        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}">
            <TextBlock.Visibility>
                <Binding Path="HasErrors">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </TextBlock.Visibility>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Speichern" Command="{Binding ConfirmCommand}" IsDefault="True" />
            <Button Content="Abbrechen" Command="{Binding CancelCommand}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
