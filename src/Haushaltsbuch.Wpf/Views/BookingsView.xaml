<UserControl x:Class="Haushaltsbuch.Wpf.Views.BookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Aktionen -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="＋ Neue Buchung" Command="{Binding AddCommand}" />
            <Button Content="Bearbeiten" Command="{Binding EditCommand}" />
            <Button Content="Löschen" Command="{Binding DeleteCommand}" />
            <Button Content="CSV-Export…" Command="{Binding ExportCommand}" Margin="24,0,8,0" />
        </StackPanel>

        <!-- Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Monat" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}"
                          DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Kategorie" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{Binding FilterCategories}" SelectedItem="{Binding SelectedFilterCategory}"
                          DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="Art" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedTypeOption}"
                          DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                <TextBlock Text="Suche (Beschreibung / Kategorie)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Button Grid.Column="4" Content="Filter zurücksetzen" Command="{Binding ResetFilterCommand}"
                    VerticalAlignment="Bottom" Margin="0" />
        </Grid>

        <!-- Tabelle -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E8ED" RowStyle="{StaticResource MonthRow}"
                  RowHeaderWidth="0" BorderBrush="#DDD" Background="White">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat={}{0:d}}" Width="110" />
                <DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="90" />
                <DataGridTextColumn Header="Kategorie" Binding="{Binding CategoryName}" Width="150" />
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Betrag" Binding="{Binding SignedAmount, StringFormat={}{0:C}}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right" />
                            <Setter Property="Padding" Value="0,0,8,0" />
                            <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Summen -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="16,10" Background="{StaticResource CardBrush}" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Einnahmen" Style="{StaticResource SummaryCaption}" />
                    <TextBlock Text="{Binding TotalIncome, StringFormat={}{0:C}}" Style="{StaticResource SummaryValue}"
                               Foreground="{StaticResource IncomeBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Ausgaben" Style="{StaticResource SummaryCaption}" />
                    <TextBlock Text="{Binding TotalExpenses, StringFormat={}{0:C}}" Style="{StaticResource SummaryValue}"
                               Foreground="{StaticResource ExpenseBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Saldo (aktuelle Ansicht)" Style="{StaticResource SummaryCaption}" />
                    <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}" Style="{StaticResource SummaryValue}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Gesamtsaldo (alle Buchungen)" Style="{StaticResource SummaryCaption}" />
                    <TextBlock Text="{Binding OverallBalance, StringFormat={}{0:C}}" Style="{StaticResource SummaryValue}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
