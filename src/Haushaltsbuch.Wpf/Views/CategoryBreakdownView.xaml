<UserControl x:Class="Haushaltsbuch.Wpf.Views.CategoryBreakdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Haushaltsbuch.Wpf.Controls">
    <!-- DataContext: CategoryBreakdownViewModel (Einnahmen ODER Ausgaben) -->
    <Grid Margin="20,0,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="160" />
            <RowDefinition Height="*" MinHeight="80" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource ExpenseBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIncome}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ComboBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Periods}"
                  SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" />

        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}">
            <Run Text="Summe: " />
            <Run Text="{Binding TotalText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1F2933" />
        </TextBlock>

        <Grid Grid.Row="3" Margin="0,8,0,8">
            <controls:PieChart Slices="{Binding Slices}" />
            <TextBlock Text="Keine Buchungen im gewählten Zeitraum" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Legende: Farbe · Kategorie · Anteil · Betrag -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Slices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="56" />
                                <ColumnDefinition Width="Auto" MinWidth="96" />
                            </Grid.ColumnDefinitions>
                            <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,8,0"
                                    Background="{Binding ColorHex}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Fraction, StringFormat={}{0:P1}}"
                                       TextAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat={}{0:C}}"
                                       TextAlignment="Right" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
