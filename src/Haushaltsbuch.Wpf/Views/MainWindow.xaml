<Window x:Class="Haushaltsbuch.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Haushaltsbuch.Wpf.Views"
        Title="Haushaltsbuch" Width="1100" Height="700" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <!-- DataContext: ShellViewModel. Jeder Tab bekommt sein eigenes ViewModel. -->
    <TabControl Style="{StaticResource NavTabControl}" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Buchungen" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconBookings}">
            <views:BookingsView DataContext="{Binding Bookings}" />
        </TabItem>
        <TabItem Header="Auswertung" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconAnalysis}">
            <views:AnalysisView DataContext="{Binding Analysis}" />
        </TabItem>
        <TabItem Header="Einstellungen" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconSettings}">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>
