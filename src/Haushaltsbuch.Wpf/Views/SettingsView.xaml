<UserControl x:Class="Haushaltsbuch.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20" MaxWidth="560" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Einstellungen" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Kategorien" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,2" />
        <TextBlock Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Neue Kategorien werden in der Datenbank gespeichert und stehen sofort bei Buchungen, Filtern und in der Auswertung zur Verfügung." />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Kategorie hinzufügen" Command="{Binding AddCommand}" Margin="0" />
        </Grid>

        <ListBox Grid.Row="4" Margin="0,12,0,0" ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource IncomeBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button Content="Ausgewählte Kategorie löschen" Command="{Binding DeleteCommand}"
                    HorizontalAlignment="Left" Margin="0" />

        </StackPanel>
    </Grid>
</UserControl>
